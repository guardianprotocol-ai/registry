{
  "id": "fetch-docs-and-write-code",
  "description": "Read documentation, write code, run the tests.",
  "events": [
    {
      "call": {
        "name": "fetch_page",
        "args": {
          "url": "https://docs.python.org/3/library/json.html"
        }
      }
    },
    {
      "output": {
        "source": "fetch_page",
        "text": "json.dumps serializes an object to a JSON formatted string."
      }
    },
    {
      "call": {
        "name": "write_file",
        "args": {
          "path": "src/export.py",
          "content": "import json\n\ndef export(data):\n    return json.dumps(data)\n"
        }
      }
    },
    {
      "call": {
        "name": "run_tests",
        "args": {
          "path": "tests/"
        }
      }
    }
  ]
}
